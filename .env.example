# ---- Database (PostgreSQL) ----
# Local: run `docker compose up -d` and keep this value.
DATABASE_URL="postgresql://flame:flame@localhost:5432/flame?schema=public"

# ---- App ----
# Public URL of the site (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Stripe (https://dashboard.stripe.com/test/apikeys) ----
# Leave blank to use DEMO payments locally (no real charge).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Stripe dashboard webhook page
STRIPE_WEBHOOK_SECRET=""
# Set to "true" only if you want demo payments on a deployed site (never for the live shop)
ALLOW_DEMO_PAYMENTS="false"

# ---- Email (any SMTP provider: Resend, Postmark, Gmail, Mailgun...) ----
# Leave SMTP_HOST blank and emails are printed to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Flame Grill & Chill <orders@flamegrillandchill.co.uk>"
# Where new-order alerts go (optional)
SHOP_NOTIFY_EMAIL=""

# ---- First admin account (created by `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@flamegrillandchill.co.uk"
SEED_ADMIN_PASSWORD="ChangeMe123!"
